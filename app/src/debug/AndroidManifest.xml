<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay (AGP debug source set). Adds the verification
  harness receiver so external tools (adb) can drive the app without UI taps.
  Never present in release builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="com.dodocomm.app.debug.SET_CONFIG" />
                <action android:name="com.dodocomm.app.debug.TEST_PUSH" />
                <action android:name="com.dodocomm.app.debug.SEED_DEMO" />
                <action android:name="com.dodocomm.app.debug.DUMP_HISTORY" />
                <action android:name="com.dodocomm.app.debug.DUMP_STATE" />
                <action android:name="com.dodocomm.app.debug.CLEAR_DATA" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
